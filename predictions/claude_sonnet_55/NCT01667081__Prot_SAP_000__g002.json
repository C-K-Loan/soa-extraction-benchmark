  "group_id": "NCT01667081__Prot_SAP_000__g002",
  "model": "anthropic/claude-sonnet-5.5",
  "references": [
    {
      "reference_marker": "1",
      "text": "Visits should be scheduled as close to the indicated study period as possible. Visit windows are +/- 3 months. All visits should be recorded on the actual date that they occur and any missed or late visits must be documented accordingly."
    },
    {
      "reference_marker": "2",
      "text": "Participation in FBR is voluntary and is not required in order to participate in the study."
    },
    {
      "reference_marker": "3",
      "text": "AEs related to protocol-specified procedures (blood draw) and drug related new Serious Adverse Events, which occur following enrollment in the present study (after Informed Consent Form is signed) will be reported."
    },
    {
      "reference_marker": "4",
      "text": "If a subject is directly entered into this long-term follow-up protocol on the same day as the last study day of the prior treatment study, only the lab kit from prior treatment study needs to be used."
    },
    {
      "reference_marker": "5",
      "text": "The screening visit should occur within 3 months of the last visit of the previous protocol."
    },
    {
      "reference_marker": "6",
      "text": "If the unscheduled visit is being performed for follow-up of an AE/SAE (as defined in this protocol), only a directed physical exam is needed at this visit. If for follow-up of viral resistance, only HCV evaluations are needed."
    },
    {
      "reference_marker": "7",
      "text": "For subjects who discontinue early, a Visit 7 (Month 36) should be completed as the early discontinuation visit."
    },
    {
      "reference_marker": "8",
      "text": "Leftover main study plasma from HCV RNA and resistance will be stored for FBR if the subject/legally acceptable representative consents to FBR."
    }
  ],
  "system": "claude_sonnet_55"
